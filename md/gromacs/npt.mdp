integrator      = md
dt              = 0.002
nsteps          = 10000
nstlist         = 25
cutoff-scheme   = Verlet
coulombtype     = cutoff
rcoulomb        = 1.2
rvdw            = 1.2
pbc             = xyz
constraints     = h-bonds
constraint-algorithm = lincs
tcoupl          = V-rescale
tc-grps         = System
tau_t           = 0.1
ref_t           = 298.15
pcoupl          = C-rescale
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = 1.0
compressibility = 4.5e-5
continuation    = yes
gen_vel         = no
nstxout         = 500
nstvout         = 500
nstenergy       = 100
nstlog          = 500
