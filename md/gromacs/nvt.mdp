integrator      = md
dt              = 0.002
nsteps          = 10000
nstlist         = 25
cutoff-scheme   = Verlet
coulombtype     = cutoff
rcoulomb        = 1.2
rvdw            = 1.2
pbc             = xyz
constraints     = h-bonds
constraint-algorithm = lincs
tcoupl          = V-rescale
tc-grps         = System
tau_t           = 0.1
ref_t           = 298.15
gen_vel         = yes
gen_temp        = 298.15
gen_seed        = -1
nstxout         = 5000
nstvout         = 5000
nstenergy       = 500
nstlog          = 5000
